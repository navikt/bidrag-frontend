{
    "extends": "../../tsconfig.packages.json",
    "include": ["src"],
    "compilerOptions": {
        "types": ["node", "vite/client"],
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        // Migrert fra den frittstående bidrag-behandling-ui som kjørte uten strict mode.
        // TODO: skru på strict gradvis.
        "strict": false,
        "noUncheckedIndexedAccess": false,
        "noImplicitOverride": false
    }
}
