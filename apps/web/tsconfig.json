    "exclude": ["../behandling-app"],
    "compilerOptions": {
        "sourceMap": true,
        "rootDirs": [".", "./.react-router/types"],
        "types": ["node", "react", "react-dom", "vite/client"],
        "paths": {
            "~/*": ["./app/*"],
            "@bidrag/behandling-app": ["./app/types/behandling-app.d.ts"],
