              <option
                value="2103"
              >
                2103 NAV Vikafossen
              </option>
              <option
                value="4865"
              >
                4865 NAV Familie- og pensjonsytelser Bidrag utland
              </option>
            </optgroup>
          </select>
        </div>
      </div>
      <input
        hidden=""
        name="personIdent"
        value="17498932282"
      />
      <div
        class="mt-4 flex flex-row gap-[10px]"
      >
        <button
          class="navds-button navds-button--primary navds-button--medium"
        >
          <span
            class="navds-label"
          >
            Lagre og overfør
          </span>
        </button>
        <button
          class="navds-button navds-button--tertiary navds-button--medium"
        >
          <span
            class="navds-label"
