              </option>
              <option
                value="4808"
              >
                4808 NAV Familie- og pensjonsytelser Porsgrunn
              </option>
              <option
                value="4811"
              >
                4811 NAV Familie- og pensjonsytelser Sandnes
              </option>
              <option
                value="4812"
              >
                4812 NAV Familie- og pensjonsytelser Bergen
              </option>
              <option
                value="4815"
              >
                4815 NAV Familie- og pensjonsytelser Ålesund
              </option>
              <option
                value="4820"
              >
                4820 NAV Familie- og pensjonsytelser Vadsø
              </option>
              <option
                value="4833"
              >
                4833 NAV Familie- og pensjonsytelser Oslo 1
              </option>
              <option
                value="4847"
              >
                4847 NAV Familie- og pensjonsytelser Levanger
              </option>
              <option
                value="4849"
              >
                4849 NAV Familie- og pensjonsytelser Tromsø
              </option>
              <option
                value="4860"
              >
                4860 NAV Familie- og pensjonsytelser Farskap
              </option>
            </optgroup>
            <optgroup
              label="Klage"
            >
              <option
                value="4250"
              >
                4250 NAV Klageinstans sør
              </option>
              <option
                value="4293"
              >
