      class="navds-heading navds-heading--medium navds-typo--spacing"
    >
      Bestill ny distribusjon
    </h3>
    <div
      class="mb-4"
    >
      <button
        class="navds-button navds-button--tertiary navds-button--small"
      >
        <span
          class="navds-button__icon"
        >
          <svg
            fill="none"
            focusable="false"
