          </span>
        </button>
        <button
          class="navds-button navds-button--tertiary navds-button--medium"
        >
          <span
            class="navds-label"
          >
            Forkast
          </span>
        </button>
      </div>
    </form>
  </section>
  <button
    aria-label="Lukk"
    class="lukknapp lukknapp--overstHjorne modal__lukkknapp--shake"
  >
    <span
      class="text-hide"
    >
