      Endre fagområde
    </h3>
    <div
      class="mb-4"
    >
      <button
        class="navds-button navds-button--tertiary navds-button--small"
      >
        <span
          class="navds-button__icon"
        >
          <svg
            fill="none"
            focusable="false"
            height="1em"
            role="img"
            viewBox="0 0 24 24"
            width="1em"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              clip-rule="evenodd"
              d="M1.793 11.793 9.5 4.086 10.914 5.5l-5.293 5.293h16.586v2H5.621l5.293 5.293L9.5 19.5l-7.707-7.707Z"
              fill="currentColor"
              fill-rule="evenodd"
            />
          </svg>
        </span>
        <span
          class="navds-label navds-label--small"
        >
          Forrige steg
        </span>
      </button>
    </div>
    <div
      class="endrefagomrade_joark"
    >
      <p
        class="navds-body-short navds-body-short--medium navds-typo--spacing"
      >
        Dette vil overføre journalpost til valgt fagområde.
        <br />
         Hvis du velger å overføre journalposten til et annet fagområde enn 
        <i>
          Bidrag
        </i>
         eller 
        <i>
          Farskap
        </i>
         
        vil også tilhørende oppgaver overføres til valgt fagområde.
        <br />
        <br />
        Hvis du velger å endre til fagområde Farskap vil tilhørende oppgaver overføres til enhet
         
        <i>
          4860
           
          NAV Familie- og pensjonsytelser Farskap
        </i>
      </p>
      <form>
        <div
          class="w-max navds-form-field navds-form-field--small"
        >
          <label
            class="navds-form-field__label navds-label navds-label--small"
          >
            Velg fagområde
          </label>
          <div
            class="navds-select__container"
          >
            <select
              class="navds-select__input navds-body-short navds-body-short--small"
              name="fagomrade"
            >
              <option
                value="AAR"
              >
                Aa-registeret
              </option>
              <option
                value="AGR"
              >
                Ajourhold - Grunnopplysninger
              </option>
              <option
                value="AAP"
              >
                Arbeidsavklaringspenger
              </option>
              <option
                value="BAR"
              >
                Barnetrygd
              </option>
              <option
                value="BIL"
              >
                Bil
              </option>
              <option
                value="DAG"
              >
                Dagpenger
              </option>
              <option
                value="ENF"
              >
                Enslig forsørger
              </option>
              <option
                value="ERS"
              >
                Erstatning
              </option>
              <option
                value="FAR"
              >
                Farskap
              </option>
              <option
                value="FOR"
              >
                Foreldre- og svangerskapspenger
              </option>
              <option
                value="FOS"
              >
                Forsikring
              </option>
              <option
                value="FUL"
              >
                Fullmakt
              </option>
              <option
                value="GRA"
              >
                Gravferdsstønad
              </option>
              <option
                value="GRU"
              >
                Grunn- og hjelpestønad
              </option>
              <option
                value="HEL"
              >
                Helsetjenester og ort. hjelpemidler
              </option>
              <option
                value="HJE"
              >
                Hjelpemidler
              </option>
              <option
                value="FRI"
              >
                Kompensasjon selvstendig næringsdrivende/frilansere
              </option>
              <option
                value="KON"
              >
                Kontantstøtte
              </option>
              <option
                value="KTR"
              >
                Kontroll
              </option>
              <option
                value="MED"
              >
                Medlemskap
              </option>
              <option
                value="OMS"
              >
                Omsorgspenger, Pleiepenger og opplæringspenger
              </option>
              <option
                value="OPA"
              >
                Oppfølging - Arbeidsgiver
              </option>
              <option
                value="PEN"
              >
                Pensjon
              </option>
              <option
                value="RVE"
              >
                Rettferdsvederlag
              </option>
              <option
                value="RPO"
              >
                Retting av personopplysninger
              </option>
              <option
                value="SAK"
              >
                Saksomkostning
              </option>
              <option
                value="SER"
              >
                Serviceklager
              </option>
              <option
                value="SUP"
              >
                Supplerende stønad
              </option>
              <option
                value="SYK"
              >
                Sykepenger
              </option>
              <option
                value="TRK"
              >
                Trekkhåndtering
              </option>
              <option
                value="TRY"
              >
                Trygdeavgift
              </option>
              <option
                value="UFO"
              >
                Uføretrygd
              </option>
              <option
                value="UFM"
              >
                Unntak fra medlemskap
              </option>
              <option
                value="VEN"
              >
                Ventelønn
              </option>
              <option
                value="YRK"
              >
                Yrkesskade / Menerstatning
              </option>
            </select>
            <svg
              aria-hidden="true"
              class="navds-select__chevron"
              fill="none"
              focusable="false"
              height="1em"
              role="img"
              viewBox="0 0 24 24"
              width="1em"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                clip-rule="evenodd"
                d="M5.97 9.47a.75.75 0 0 1 1.06 0L12 14.44l4.97-4.97a.75.75 0 1 1 1.06 1.06l-5.5 5.5a.75.75 0 0 1-1.06 0l-5.5-5.5a.75.75 0 0 1 0-1.06Z"
                fill="currentColor"
                fill-rule="evenodd"
              />
            </svg>
          </div>
          <div
            aria-live="polite"
            aria-relevant="additions removals"
            class="navds-form-field__error"
          />
        </div>
        <div
          class="mt-4 flex flex-row gap-[10px]"
        >
          <button
            class="navds-button navds-button--primary navds-button--medium"
          >
            <span
              class="navds-label"
            >
              Overfør
            </span>
          </button>
          <button
            class="navds-button navds-button--tertiary navds-button--medium"
          >
            <span
              class="navds-label"
            >
              Forkast
            </span>
          </button>
        </div>
      </form>
    </div>
  </section>
  <button
    aria-label="Lukk"
    class="lukknapp lukknapp--overstHjorne modal__lukkknapp--shake"
  >
    <span
      class="text-hide"
    >
      Lukk
    </span>
  </button>
</div>
`;

