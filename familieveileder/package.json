{
    "name": "bidrag-familieveileder",
    "version": "0.0.0",
    "private": true,
    "packageManager": "pnpm@11.8.0",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "webpack serve --config webpack.dev.config.mjs",
        "build": "webpack --config webpack.prod.config.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "prettier": "prettier --check src",
        "format": "prettier --write src && eslint src --fix"
    },
    "dependencies": {
        "@navikt/ds-css": "8.14.0",
        "@navikt/ds-icons": "3.4.3",
        "@navikt/ds-react": "8.14.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@navikt/ds-tailwind": "8.14.0",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "autoprefixer": "^10.6.2",
        "css-loader": "^7.1.5",
        "esbuild": "^0.28.2",
        "esbuild-loader": "4.5.0",
        "eslint": "10.1.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-json-format": "^2.0.1",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.13.0",
        "html-webpack-plugin": "^5.6.8",
        "jsdom": "^30.1.3",
        "postcss": "^8.5.32",
        "postcss-import": "16.1.0",
        "postcss-loader": "^8.2.1",
        "prettier": "^3.9.10",
        "style-loader": "^4.0.0",
        "tailwindcss": "^3.4.19",
        "typescript": "5.7.3",
        "vitest": "^5.0.5",
        "webpack": "5.112.2",
        "webpack-cli": "6.0.1",
        "webpack-dev-server": "5.2.3",
        "webpack-merge": "^6.0.1"
    }
}
