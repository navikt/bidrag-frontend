{
    "name": "bidrag-frontend",
    "private": true,
    "scripts": {
        "build": "pnpm run -r build",
        "build:web": "pnpm --filter web build",
        "dev": "printf \"\\033[1;33m%s\\033[0m\\n\" \"Bruk frontend via Wonderwall: http://localhost:4000 (ikke http://localhost:3000)\" && pnpm --filter web dev",
        "typecheck": "pnpm -r run typecheck && pnpm typecheck:ct",
        "typecheck:ct": "tsc --project playwright/tsconfig.json",
        "typecheck:changed": "pnpm --filter \"[origin/main]\" run typecheck",
        "lint": "biome lint .",
        "lint:changed": "biome lint --changed --since=origin/main --no-errors-on-unmatched",
        "biome:ci": "biome ci",
        "biome:ci:changed": "biome ci --changed --since=origin/main --no-errors-on-unmatched",
        "format": "biome format .",
        "check": "biome check .",
        "check:changed": "biome check --changed --since=origin/main",
        "check:changed:write": "biome check --write --changed --since=origin/main --no-errors-on-unmatched",
        "fallow": "fallow",
        "fallow:json": "fallow --format json --quiet",
        "fallow:health": "fallow health",
        "fallow:dupes": "fallow dupes",
        "fallow:dead-code": "fallow dead-code",
        "test": "pnpm -r --if-present run test",
        "test:ct": "playwright test --project=components",
        "test:ct:slow": "playwright test --project=components-slow",
        "test:ct:ui": "playwright test --ui",
        "dev:ct": "vite --config playwright/vite.config.ts",
        "test:e2e": "pnpm --dir e2e exec playwright test",
        "test:e2e:local": "TEST_ENV=local pnpm --dir e2e exec playwright test",
        "test:e2e:q2": "TEST_ENV=q2 pnpm --dir e2e exec playwright test",
        "kill:gallery": "lsof -ti tcp:3178 | xargs kill -9 2>/dev/null || true",
        "deploy:clean": "rm -rf deploy_dist",
        "deploy:web": "pnpm --filter web --prod --legacy deploy deploy_dist",
        "deploy:docker": "pnpm run build && pnpm run deploy:clean && pnpm run deploy:web"
    },
    "devDependencies": {
        "@axe-core/playwright": "catalog:",
        "@biomejs/biome": "^2.5.0",
        "@navikt/ds-css": "catalog:",
        "@playwright/test": "catalog:",
        "@tailwindcss/vite": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "fallow": "^3.28.0",
        "playwright": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "tsx": "^4.22.4",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "^4.1.9"
    },
    "engines": {
        "node": ">=24",
        "pnpm": ">=11"
    },
    "packageManager": "pnpm@11.24.0"
}
