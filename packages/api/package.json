{
    "name": "@bidrag/api",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "import": "./src/index.ts"
        },
        "./*": {
            "import": "./src/api/*.ts"
        }
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests",
        "api:all": "pnpm run api:person && pnpm run api:sak && pnpm run api:tilgangskontroll && pnpm run api:samhandler && pnpm run api:organisasjon && pnpm run api:belopshistorikk && pnpm run api:bidragDokument && pnpm run api:bidragVedtak && pnpm run api:reskontro",
        "generate:api": "pnpm run api:all",
        "api:person": "swagger-typescript-api generate -p https://bidrag-person-q2.intern.dev.nav.no/bidrag-person/v3/api-docs --axios -n PersonApi.ts -o src/api",
        "api:sak": "swagger-typescript-api generate -p https://bidrag-sak-q2.intern.dev.nav.no/v3/api-docs --axios -n SakApi.ts -o src/api",
        "api:bidragAdmin": "swagger-typescript-api generate -p https://bidrag-admin.intern.dev.nav.no/v3/api-docs --axios -n BidragAdminApi.ts -o src/api",
        "api:bidragBehandling": "swagger-typescript-api generate -p https://bidrag-behandling-q1.intern.dev.nav.no/v3/api-docs --extract-enums --enum-names-as-values --axios -n BidragBehandlingApiV1.ts -o src/api",
        "api:bidragBehandling:Q2": "swagger-typescript-api generate -p https://bidrag-behandling-q2.intern.dev.nav.no/v3/api-docs --extract-enums --enum-names-as-values --axios -n BidragBehandlingApiV1.ts -o src/api",
        "api:bidragBehandling:local": "swagger-typescript-api generate -p http://localhost:8990/v3/api-docs --extract-enums --enum-names-as-values --axios -n BidragBehandlingApiV1.ts -o src/api",
        "api:vedtak:local": "swagger-typescript-api generate -p http://localhost:8889/v3/api-docs --extract-enums --enum-names-as-values --axios -n BidragVedtakApi.ts -o src/api",
        "api:github": "swagger-typescript-api generate -p https://raw.githubusercontent.com/github/rest-api-description/main/descriptions/api.github.com/api.github.com.json --extract-enums --enum-names-as-values --axios -n GithubApi.ts -o src/api",
        "types:bidragBehandling": "swagger-typescript-api generate -p https://bidrag-behandling-q1.dev.intern.nav.no/v3/api-docs -o src/types",
        "api:tilgangskontroll": "swagger-typescript-api generate -p https://bidrag-tilgangskontroll.intern.dev.nav.no/v3/api-docs --axios -n TilgangskontrollApi.ts -o src/api",
        "api:samhandler": "swagger-typescript-api generate -p https://bidrag-samhandler-q2.intern.dev.nav.no/v3/api-docs --axios -n SamhandlerApi.ts -o src/api",
        "api:organisasjon": "swagger-typescript-api generate -p https://bidrag-organisasjon-feature.intern.dev.nav.no/bidrag-organisasjon/v3/api-docs --axios -n OrganisasjonApi.ts -o src/api",
        "api:belopshistorikk": "swagger-typescript-api generate -p https://bidrag-belopshistorikk-q2.intern.dev.nav.no/v3/api-docs --axios -n BelopshistorikkApi.ts -o src/api",
        "api:bidragDokument": "swagger-typescript-api generate -p https://bidrag-dokument.intern.dev.nav.no/bidrag-dokument/v3/api-docs --extract-enums --enum-names-as-values --axios -n BidragDokumentApi.ts -o src/api",
        "api:bidragVedtak": "swagger-typescript-api generate -p https://bidrag-vedtak-q2.intern.dev.nav.no/v3/api-docs --axios -n BidragVedtakApi.ts -o src/api",
        "api:reskontro": "swagger-typescript-api generate -p https://bidrag-reskontro-q2.intern.dev.nav.no/v3/api-docs --axios -n BidragReskontroApi.ts -o src/api",
        "api:bidragDokumentProduksjon": "swagger-typescript-api generate -p https://bidrag-dokument-produksjon.intern.dev.nav.no/v3/api-docs --extract-enums --axios -n BidragDokumentProduksjonApi.ts -o src/api",
        "api:dokumentArkiv": "swagger-typescript-api generate -p https://bidrag-dokument-arkiv.intern.dev.nav.no/bidrag-dokument-arkiv/v3/api-docs --extract-enums --axios -n BidragDokumentArkivApi.ts -o src/api",
        "api:forsendelse": "swagger-typescript-api generate -p https://bidrag-dokument-forsendelse.intern.dev.nav.no/v3/api-docs --axios -n BidragForsendelseApi.ts -o src/api",
        "api:kodeverk": "swagger-typescript-api generate -p https://bidrag-kodeverk.intern.dev.nav.no/v3/api-docs --axios -n BidragKodeverkApi.ts -o src/api"
    },
    "dependencies": {
        "axios": "^1.18.0",
        "@types/node": "^25"
    },
    "devDependencies": {
        "typescript": "catalog:",
        "swagger-typescript-api": "13.12.2"
    }
}
